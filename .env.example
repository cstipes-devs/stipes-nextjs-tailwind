# Copy to `.env.local` and adjust. `.env.local` is gitignored — never commit it.
# Every variable here is OPTIONAL; the app and test suite work with none of them set.

# --- Application ---------------------------------------------------------

# Upstream chat service that /api/chat proxies to.
# Defaults to https://stipes-openai-chat.vercel.app/chat when unset (see
# app/api/chat/route.ts and docs/CRITICAL_FLOWS.md Flow 1). Point this at a
# local Go service when developing the backend.
# CHAT_API_URL=http://localhost:8080/chat

# --- Playwright ----------------------------------------------------------

# Target a deployed site instead of localhost. When set, it becomes the
# Playwright baseURL, the local dev server is NOT started, timeouts rise, and
# failed tests retry to absorb network flake. Used by `npm run smoke`.
# SMOKE_BASE_URL=https://your-deployment.vercel.app

# Override the local dev/test server origin (default http://localhost:3000).
# Useful when port 3000 is taken. Applies to both baseURL and the webServer.
# PLAYWRIGHT_BASE_URL=http://localhost:3001

# Force headed mode / slow motion when debugging locally.
# PWDEBUG=1
